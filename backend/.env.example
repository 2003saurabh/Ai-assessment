# =============================================================================
# AWS Authentication Configuration
# =============================================================================
# Choose ONE of the following methods:

# --- Option 1: SSO (local development) ---
# Run: aws sso login --profile <your-profile>
AWS_AUTH_METHOD=sso
AWS_PROFILE=default
AWS_DEFAULT_REGION=ap-south-1

# --- Option 2: Access Keys (CI/CD, non-SSO accounts) ---
# AWS_AUTH_METHOD=access_keys
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=ap-south-1

# --- Option 3: EC2 Instance / ECS with IAM Role (production) ---
# No credentials needed — uses instance metadata automatically.
# AWS_AUTH_METHOD=iam_role
# AWS_DEFAULT_REGION=ap-south-1

# =============================================================================
# Model Configuration
# =============================================================================
# Sonnet — used for final answer generation (quality)
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0

# Haiku — used for routing + SQL generation (speed)
BEDROCK_FAST_MODEL_ID=apac.anthropic.claude-3-5-haiku-20241022-v1:0

# =============================================================================
# Database Configuration (PostgreSQL + pgvector)
# =============================================================================
DATABASE_URL=postgresql://technova:technova_secret@localhost:5432/technova_db
POSTGRES_USER=technova
POSTGRES_PASSWORD=technova_secret
POSTGRES_DB=technova_db
